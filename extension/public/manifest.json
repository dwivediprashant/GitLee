{
  "manifest_version": 3,
  "name": "GitLee",
  "version": "1.0.0",
  "description": "Sync your accepted LeetCode solutions to GitHub automatically.",
  "permissions": ["storage", "identity", "tabs", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://leetcode.com/*",
    "https://gitlee-backend.onrender.com/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": []
}
